          ""
        ],
        [
          "⏱ 调整休眠时间(24h)",
          "settings put system screen_off_timeout 86400000",
          ""
        ],
        [
          "📂 查看 U 盘挂载",
          "ls /mnt/media_rw/",
          ""
        ],
        [
