    {
      "id": "dyn:1774410656569",
      "title": "调试日志",
      "parent_id": "dyn:1774410263125",
      "hint": "",
      "commands": [
        {
          "name": "📜 监听 GM 调试日志",
          "cmd": "logcat | grep GM_DISP_DBG"
        },
        {
          "name": "打印硬件版本",
          "cmd": "getprop | grep model"
        },
        {
          "name": "打印tag版本",
          "cmd": "getprop | grep apollo"
        },
        {
          "name": "后台抓取日志",
          "cmd": "logcat -c\nlogcat >/data/logcat.log&"
        },
        {
          "name": "抓取simplepref",
          "cmd": "simpleperf record -a --duration 10 -o /data/1.bin"
        },
        {
          "name": "抓取traces   （需要把/data/misc/perfetto-traces/trace_file.perfetto-trace拷贝出来）",
          "cmd": "setprop persist.traced.enable 1\nperfetto -o /data/misc/perfetto-traces/trace_file.perfetto-trace -t 20s sched freq idle am wm gfx view binder_driver hal dalvik camera input res memory"
        }
      ]
    }
