[
  {
    "name": "关闭AVB",
    "cmd": "avb init 0;avb set-devicestate 0;avb set-verity disable;save;reset"
  },
  {
    "name": "还原备份的so",
    "cmd": "cp /data/libxgimi.so /vendor/lib"
  },
  {
    "name": "打印tag版本",
    "cmd": "getprop | grep apollo"
  },
  {
    "name": "打印硬件版本",
    "cmd": "getprop | grep model"
  },
  {
    "name": "关风控",
    "cmd": "stop xgimi_middle;\ncri temperature_bypass true;  \nreboot"
  },
  {
    "name": "set dlp_bypass",
    "cmd": "cri set dlp_bypass 1"
  },
  {
    "name": "get dlp_bypass",
    "cmd": "cri get dlp_bypass"
  },
  {
    "name": "reset",
    "cmd": "reset"
  },
  {
    "name": "reboot",
    "cmd": "reboot"
  }
