{
  "custom_commands": [
    {
      "name": "调整休眠(24h)",
      "cmd": "settings put system screen_off_timeout 86400000"
    },
    {
      "name": "查看vendor目录",
      "cmd": "ls /vendor/lib/ | grep xgimi"
    },
    {
      "name": "打印tag版本",
      "cmd": "getprop | grep apollo"
    },
    {
      "name": "打印硬件版本",
      "cmd": "getprop | grep model"
    },
    {
      "name": "重启ADB",
      "cmd": "adb kill-server;\nadb start-server"
    }
  ],
  "dynamic_sections": [
    {
      "type": "dynamic_section",
      "title": "SVM模型测试相关",
      "commands": [
        {
          "name": "su",
          "cmd": "su;remount"
        },
        {
          "name": "查看原模型",
          "cmd": "ls -lh /mnt/vendor/xgimiconfig/G0118/kstAdjust/"
        },
        {
          "name": "删除符号链接",
          "cmd": "rm /mnt/vendor/xgimiconfig/G0118/kstAdjust/norm_params.yaml；rm /mnt/vendor/xgimiconfig/G0118/kstAdjust/svm_model.xml"
        },
        {
          "name": "拷贝新模型",
          "cmd": "cp /mnt/media_rw/0182-0265/norm_params.yaml /mnt/vendor/xgimiconfig/G0118/kstAdjust/；cp /mnt/media_rw/0182-0265/svm_model.xml /mnt/vendor/xgimiconfig/G0118/kstAdjust/"
        },
        {
          "name": "查看新模型",
          "cmd": "ls -lh /mnt/vendor/xgimiconfig/G0118/kstAdjust/"
        },
        {
          "name": "下点（需要修改坐标）",
          "cmd": "gmpfUnit correctKeystone2"
        },
        {
          "name": "logcat | grep svm",
          "cmd": "logcat | grep svm"
        }
      ]
    },
    {
      "type": "dynamic_section",
      "title": "固件升级（AOSP)",
      "commands": [
        {
          "name": "mboot更新指令（注意修改文件名）",
          "cmd": "mtkupgrade usb XGIMI_GOATELEGANT_XR03D.bin"
        }
      ]
    }
  ]
}