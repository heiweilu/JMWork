{
  "version": 2,
  "theme": {
    "dark_mode": false
  },
  "custom_commands": [
    {
      "name": "查看vendor目录的so",
      "cmd": "ls /vendor/lib/ | grep xgimi"
    },
    {
      "name": "调用播放播放视频",
      "cmd": "am start -a android.intent.action.MAIN -n com.xgimi.gimiplayer/com.xgimi.gimiplayer.activity.VideoPlayerActivity --es video-path \"/sdcard/3D_FSBS_test.mkv\""
    },
    {
      "name": "关风控",
      "cmd": "stop xgimi_middle;\ncri temperature_bypass true;  \nreboot"
    }
  ],
  "fixed_sections": {
    "firmware": {
      "title": "📦 固件升级（GTV）",
      "hint": "💡 <b>固件升级流程说明</b><br>1. 将 <code>libxgimi.so</code> 拷贝到 U 盘根目录<br>2. U 盘插入投影仪，确认挂载路径<br>3. 按顺序执行以下步骤（建议每步确认结果后再点下一步）<br>4. 升级完成后记得备份原始 so 文件到安全位置",
      "commands": [
        [
          "① su",
          "su",
          "切换到超级用户（root）"
        ],
        [
          "② remount",
          "remount\nchmod 777 -R /mnt/scratch/overlay\ncd /",
          "重新挂载文件系统为可读写（允许修改 /vendor）"
        ],
        [
          "③ 备份原始so",
          "cp /vendor/lib/libxgimi.so /data/",
          "将原始 libxgimi.so 备份到 /data/ 目录，防止升级失败无法恢复"
        ],
        [
          "④ 升级新so",
          "cp /mnt/media_rw/0182-0265/libxgimi.so /vendor/lib/",
          "从 U 盘（UUID: 0182-0265）拷贝新的 libxgimi.so 到 /vendor/lib"
        ],
        [
          "⑤ sync",
          "sync",
          "同步文件系统缓冲区，确保写入完成"
        ],
        [
          "⑥ reboot",
          "reboot",
          "重启投影仪，新固件生效"
        ]
      ]
    },
    "angle_collect": {
      "title": "🧪 角度采集测试",
      "hint": "遍历 Yaw × Pitch 二维网格，调用 batchGetDisplayPointByAngle 将每个角度对应的四角坐标写入 CSV（位于设备 /data/vendor/）。\n完成后需将 CSV 文件拷贝回 U 盘取走分析。",
      "scan_cmd_template": "gmpfUnit externDisplay kst_dev batchGetDisplayPointByAngle \"yaw;pitch;{resolution};{yaw_min};{yaw_max};{pitch_min};{pitch_max};{step};/data/vendor\"",
      "copy_csv_cmd": "cp data/vendor/ak_scan_yaw_pitch_step1_20260312_064414.csv /mnt/media_rw/0182-0265/"
    },
    "kst_angle": {
      "title": "📐 set_kst_by_angle",
      "template": "gmpfUnit externDisplay kst_dev set_kst_by_angle \"{yaw};{pitch};{resolution}\""
    },
    "kst_coord": {
      "title": "📌 set_kst_by_coord",
      "template": "gmpfUnit externDisplay kst_dev set_kst_by_coord \"{tl};{tr};{bl};{br}\""
    },
    "system_tools": {
      "title": "🔧 系统工具",
      "commands": [
        [
          "🔒 关闭 AVB 验证",
          "avb init 0;avb set-devicestate 0;avb set-verity disable;save;reset",
          ""
        ],
        [
          "📂 查看 U 盘挂载",
          "ls /mnt/media_rw/",
          ""
        ],
        [
          "📁 查看 vendor lib",
          "ls /vendor/lib/ | grep xgimi",
          ""
        ],
        [
          "🔍 查看设备信息",
          "getprop ro.product.model && getprop ro.build.version.release",
          ""
        ]
      ]
    },
    "custom_commands": {
      "title": "📝 自定义快捷指令"
    }
  },
  "dynamic_sections": [
    {
      "id": "dyn:1773910651945",
      "title": "📦 固件升级（AOSP)",
      "parent_id": "",
      "hint": "对于国内的机器，比如雅典娜三代：\n1. 下载固件改名存放到U盘；\n2. 运行第一个指令，等待升级完成；\n3. 升级完成后进入系统后，运行第二个指令；",
      "commands": [
        {
          "name": "mboot更新指令（注意修改文件名）",
          "cmd": "mtkupgrade usb XGIMI_HORSEPOPULAR_XR08C.bin"
        },
        {
          "name": "remount",
          "cmd": "su; remount; chmod 777 -R /mnt/scratch/overlay; cd /;"
        }
      ]
    },
    {
      "id": "dyn:1773910651940",
      "title": "SVM模型测试相关",
      "parent_id": "",
      "hint": "",
      "commands": [
        {
          "name": "su",
          "cmd": "su;remount"
        },
        {
          "name": "查看原模型",
          "cmd": "ls -lh /mnt/vendor/xgimiconfig/G0118/kstAdjust/"
        },
        {
          "name": "删除符号链接",
          "cmd": "rm /mnt/vendor/xgimiconfig/G0118/kstAdjust/norm_params.yaml\nrm /mnt/vendor/xgimiconfig/G0118/kstAdjust/svm_model.xml"
        },
        {
          "name": "拷贝新模型",
          "cmd": "cp /mnt/media_rw/0182-0265/norm_params.yaml /mnt/vendor/xgimiconfig/G0118/kstAdjust/；cp /mnt/media_rw/0182-0265/svm_model.xml /mnt/vendor/xgimiconfig/G0118/kstAdjust/"
        },
        {
          "name": "查看新模型",
          "cmd": "ls -lh /mnt/vendor/xgimiconfig/G0118/kstAdjust/"
        },
        {
          "name": "下点（需要修改坐标）",
          "cmd": "gmpfUnit correctKeystone2"
        },
        {
          "name": "logcat | grep svm",
          "cmd": "logcat | grep svm"
        }
      ]
    },
    {
      "id": "dyn:1774350309133",
      "title": "ADB",
      "parent_id": "",
      "hint": "",
      "commands": []
    },
    {
      "id": "dyn:1774350334465",
      "title": "常用",
      "parent_id": "dyn:1774350309133",
      "hint": "",
      "commands": [
        {
          "name": "重启ADB",
          "cmd": "adb kill-server; adb start-server"
        }
      ]
    },
    {
      "id": "dyn:1774409685107",
      "title": "DLP/AK",
      "parent_id": "",
      "hint": "",
      "commands": [
        {
          "name": "查看是软梯or硬梯",
          "cmd": "logcat | grep -i \"act\"\ngmpfUnit info | grep -i \"act\""
        }
      ]
    },
    {
      "id": "dyn:1774409696889",
      "title": "屏幕相关",
      "parent_id": "dyn:1774409685107",
      "hint": "",
      "commands": [
        {
          "name": "2k 60hz （都需要先设置默认画面）",
          "cmd": "gmpfUnit externDisplay setsoctiming 6\ngmpfUnit externDisplay setouttiming 6"
        },
        {
          "name": "2k 120hz",
          "cmd": "gmpfUnit externDisplay setsoctiming 4\ngmpfUnit externDisplay setouttiming 4"
        },
        {
          "name": "2k 240hz",
          "cmd": "gmpfUnit externDisplay setsoctiming 7\ngmpfUnit externDisplay setouttiming 7"
        },
        {
          "name": "查看设备分辨率/频率信息",
          "cmd": "gmpfUnit externDisplay  disp_dev read_source_timing"
        },
        {
          "name": "⏱ 调整休眠时间(24h)",
          "cmd": "settings put system screen_off_timeout 86400000"
        },
        {
          "name": "获取当前梯形坐标点",
          "cmd": "gmpfUnit getCorrectKeystone2 0"
        }
      ]
    },
    {
      "id": "dyn:1774409992724",
      "title": "投影",
      "parent_id": "dyn:1774409685107",
      "hint": "",
      "commands": [
        {
          "name": "投影方向( 0x6 0x4 )",
          "cmd": "gmpfUnit externDisplay WriteDlpIIC '0x71' '0xe6 0x1 0x0 0x6' '4'\ngmpfUnit externDisplay WriteDlpIIC '0x51' '0xe1 0x0 0x0' '3'\n\ngmpfUnit externDisplay ReadDlpIIC '0xe2' '6'\ngmpfUnit externDisplay disp_dev disp_read \"0x91;0xe6;4\""
        },
        {
          "name": "梯形下点",
          "cmd": "gmpfUnit correctKeystone2 0 0 1 3839 0 0 2159 3839 2159"
        }
      ]
    },
    {
      "id": "dyn:1774410167772",
      "title": "上下电/开关灯",
      "parent_id": "dyn:1774409685107",
      "hint": "",
      "commands": [
        {
          "name": "dlp 上电",
          "cmd": "gmpfUnit externDisplay poweronoff 1"
        },
        {
          "name": "下电",
          "cmd": "gmpfUnit externDisplay poweronoff 0"
        },
        {
          "name": "开灯",
          "cmd": "gmpfUnit externDisplay setledon 1"
        },
        {
          "name": "关灯",
          "cmd": "gmpfUnit externDisplay setledon 0"
        }
      ]
    },
    {
