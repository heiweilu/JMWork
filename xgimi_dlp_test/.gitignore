# Python 编译缓存
*.pyc
*.pyo
*.pyd
__pycache__/

# PyInstaller 打包产物（通过 GitHub Release 分发，不入库）
dist/
build/
*.spec.bak

# 虚拟环境
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# 日志与报告（运行时生成）
logs/*.log
logs/*.txt
reports/

# 临时文件
temp/
data/temp_img/
data/data_temp/
*.tmp

# AI 配置（含 API Key 等敏感信息）
config/ai_config.json

# 手动添加的文档（不随包分发）
assets/doc/

# 运行时状态数据（管理员控制台、历史浏览等）
config/admin_console.json
config/bug_tracking_data.json
config/device_lab_profile.json

# 系统文件
Thumbs.db
.DS_Store